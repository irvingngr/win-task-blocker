<Window x:Class="WinTaskBlocker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Win Task Blocker"
        Icon="pack://application:,,,/Assets/logo.png"
        Width="1080" Height="700"
        MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="16"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Root Translucent Glass Surface (like example.jpg + Wintoys integrated header) -->
    <Border x:Name="RootGlassBorder"
            CornerRadius="16"
            BorderBrush="#48FFFFFF"
            BorderThickness="1.2"
            ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush x:Name="RootGlassGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="GradStop1" Color="#BA3B1D5E" Offset="0.0"/>
                <GradientStop x:Name="GradStop2" Color="#B52B194D" Offset="0.45"/>
                <GradientStop x:Name="GradStop3" Color="#BC151936" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Integrated Wintoys Titlebar -->
                <RowDefinition Height="54"/>
                <!-- Main Body -->
                <RowDefinition Height="*"/>
                <!-- Bottom Status Bar -->
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- ==================== INTEGRATED TITLE BAR (WINTOYS STYLE) ==================== -->
            <Border Grid.Row="0"
                    Background="#18FFFFFF"
                    BorderBrush="#28FFFFFF"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Brand & Official Win Task Blocker Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               Width="32" Height="32"
                               Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Win Task Blocker" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="v2.0 Acrylic Edition" Foreground="#CBD5E1" FontSize="10.5"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Global Predictive Search Bar (Integrated in Titlebar like example.jpg / Wintoys) -->
                    <Border Grid.Column="1"
                            MaxWidth="440"
                            Height="34"
                            CornerRadius="17"
                            Background="#26FFFFFF"
                            BorderBrush="#42FFFFFF"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Margin="10,0">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" FontSize="12" Opacity="0.85"/>
                            <TextBox x:Name="GlobalSearchBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     CaretBrush="#C084FC"
                                     VerticalContentAlignment="Center"
                                     FontSize="12.5"
                                     TextChanged="GlobalSearchBox_TextChanged"/>
                            <TextBlock x:Name="GlobalSearchPlaceholder"
                                       Grid.Column="1"
                                       Text="Buscar procesos, reglas o archivos .exe..."
                                       Foreground="#B8CBD5E1"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <Button x:Name="ClearSearchBtn"
                                    Grid.Column="2"
                                    Content="✕"
                                    Visibility="Collapsed"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    Width="22" Height="22"
                                    Click="ClearSearchBtn_Click"/>
                        </Grid>
                    </Border>

                    <!-- Engine Status Badge & Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="HeaderEngineBadge"
                                Background="#2822C55E"
                                BorderBrush="#6622C55E"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,4"
                                Margin="0,0,12,0"
                                Cursor="Hand"
                                MouseLeftButtonUp="ToggleEngine_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="EngineStatusDot" Width="8" Height="8" Fill="#4ADE80" Margin="0,0,6,0"/>
                                <TextBlock x:Name="EngineStatusHeaderText" Text="Protección Activa" Foreground="White" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource TitleBarButtonStyle}" ToolTip="Minimizar a la bandeja" Click="MinimizeWindow_Click" Content="—"/>
                        <Button Style="{StaticResource TitleBarButtonStyle}" ToolTip="Maximizar / Restaurar" Click="MaximizeWindow_Click" Content="▢"/>
                        <Button Style="{StaticResource TitleBarButtonStyle}" ToolTip="Cerrar" Click="CloseWindow_Click" Content="✕"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== MAIN BODY (SIDEBAR + CONTENT) ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Wintoys Navigation Sidebar -->
                    <ColumnDefinition Width="235"/>
                    <!-- Active View Content -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR -->
                <Border Grid.Column="0"
                        Background="#180F172A"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="0,0,1,0"
                        Padding="12,14">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="PANEL DE CONTROL" Foreground="#94A3B8" FontSize="10.5" FontWeight="Bold" Margin="10,0,0,8"/>

                            <RadioButton x:Name="NavBlockedBtn"
                                         Style="{StaticResource NavRadioButtonStyle}"
                                         IsChecked="True"
                                         Checked="NavButton_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡️" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Tareas Bloqueadas"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavConditionalBtn"
                                         Style="{StaticResource NavRadioButtonStyle}"
                                         Checked="NavButton_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Bloqueo Condicional"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavStartupBtn"
                                         Style="{StaticResource NavRadioButtonStyle}"
                                         Checked="NavButton_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Inicio de Windows"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavPrefsBtn"
                                         Style="{StaticResource NavRadioButtonStyle}"
                                         Checked="NavButton_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="14" Margin="0,0,10,0"/>
                                    <TextBlock Text="Preferencias y Cristal"/>
                                </StackPanel>
                            </RadioButton>

                            <Separator Background="#28FFFFFF" Margin="6,14"/>

                            <TextBlock Text="PERFILES RÁPIDOS" Foreground="#94A3B8" FontSize="10.5" FontWeight="Bold" Margin="10,0,0,8"/>

                            <Button Style="{StaticResource GlassButtonStyle}" HorizontalContentAlignment="Left" Margin="0,3" Click="QuickFilterAll_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋  Todos los procesos" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GlassButtonStyle}" HorizontalContentAlignment="Left" Margin="0,3" Click="QuickFilterAdobe_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔴  Suite Adobe" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GlassButtonStyle}" HorizontalContentAlignment="Left" Margin="0,3" Click="QuickFilterLogitech_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔵  Logitech G HUB" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GlassButtonStyle}" HorizontalContentAlignment="Left" Margin="0,3" Click="QuickFilterRemote_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🟠  Acceso Remoto" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Quick Stats Card at Bottom of Sidebar -->
                        <Border DockPanel.Dock="Bottom"
                                Background="#24FFFFFF"
                                BorderBrush="#38FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="RESUMEN DE SESIÓN" Foreground="#CBD5E1" FontSize="10" FontWeight="Bold"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="SidebarActiveRulesCount" Text="13" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="Reglas Activas" Foreground="#CBD5E1" FontSize="10.5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="SidebarTotalBlockedCount" Text="29" Foreground="#C084FC" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="Bloqueados" Foreground="#CBD5E1" FontSize="10.5"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- ==================== RIGHT CONTENT PANELS ==================== -->
                <Grid Grid.Column="1" Margin="18,14,18,14">

                    <!-- ==================== VIEW 1: BLOCKED TASKS LIST ==================== -->
                    <Grid x:Name="ViewBlockedTasks" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Toolbar -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Lista de Tareas Bloqueadas" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Intercepta procesos en tiempo real con íconos nativos, búsqueda predictiva y conteo." Foreground="#CBD5E1" FontSize="12.5" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="StartStopEngineBtn"
                                        Style="{StaticResource GlassButtonStyle}"
                                        Margin="0,0,8,0"
                                        Click="ToggleEngine_Click"
                                        Content="⏸ Pausar Motor"/>
                                <Button Style="{StaticResource GlassButtonStyle}"
                                        Margin="0,0,8,0"
                                        Click="ImportExportIni_Click"
                                        ToolTip="Importar o guardar config.ini clásico"
                                        Content="📂 config.ini"/>
                                <Button Style="{StaticResource AccentButtonStyle}"
                                        Click="OpenAddTaskDialog_Click"
                                        Content="＋ Agregar Tarea"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Quick Predictive Add Bar + Action Buttons -->
                        <Border Grid.Row="1"
                                Background="#22FFFFFF"
                                BorderBrush="#36FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,10"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <TextBox x:Name="QuickAddProcessBox"
                                             Style="{StaticResource GlassTextBoxStyle}"
                                             TextChanged="QuickAddProcessBox_TextChanged"
                                             KeyDown="QuickAddProcessBox_KeyDown"/>
                                    <TextBlock x:Name="QuickAddPlaceholder"
                                               Text="⚡ Escritura predictiva: escribe el nombre de un proceso (ej. adobe, chrome, anydesk.exe) y presiona Enter..."
                                               Foreground="#94A3B8"
                                               FontSize="12"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                    <Popup x:Name="PredictivePopup"
                                           PlacementTarget="{Binding ElementName=QuickAddProcessBox}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True">
                                        <Border Background="#F21E1B4B"
                                                BorderBrush="#66C084FC"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="4"
                                                Width="460"
                                                MaxHeight="210">
                                            <ListBox x:Name="PredictiveSuggestionsList"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="White"
                                                     SelectionChanged="PredictiveSuggestionsList_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="4,3">
                                                            <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" Foreground="White" Width="180"/>
                                                            <TextBlock Text="{Binding Description}" Foreground="#CBD5E1" FontSize="11.5"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <Button Grid.Column="1"
                                        Style="{StaticResource GlassButtonStyle}"
                                        Margin="0,0,8,0"
                                        Click="QuickAddConfirm_Click"
                                        Content="Bloquear Ahora"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource GlassButtonStyle}"
                                        Margin="0,0,8,0"
                                        Click="ResetCounters_Click"
                                        Content="↺ Reiniciar Conteos"/>
                                <Button Grid.Column="3"
                                        Style="{StaticResource GlassButtonStyle}"
                                        Click="RemoveSelectedTask_Click"
                                        Content="🗑 Eliminar"/>
                            </Grid>
                        </Border>

                        <!-- Blocked Tasks Glass Table -->
                        <Border Grid.Row="2"
                                Background="#1EFFFFFF"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Table Column Headers -->
                                <Border Grid.Row="0" BorderBrush="#28FFFFFF" BorderThickness="0,0,0,1" Padding="12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="125"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="SelectAllCheckBox" Grid.Column="0" VerticalAlignment="Center" IsChecked="True" Click="SelectAllCheckBox_Click" ToolTip="Activar/Desactivar todos"/>
                                        <TextBlock Grid.Column="1" Text="Icono" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Proceso (.exe)" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="Descripción / Ruta" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="Perfil / Grupo" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="Bloqueados" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="" Grid.ColumnSpan="1"/>
                                    </Grid>
                                </Border>

                                <!-- ListBox of Blocked Task Rows -->
                                <ListBox x:Name="BlockedTasksListBox"
                                         Grid.Row="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,2"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="rowBd"
                                                                Background="#12FFFFFF"
                                                                BorderBrush="#1EFFFFFF"
                                                                BorderThickness="1"
                                                                CornerRadius="9"
                                                                Padding="12,7"
                                                                Margin="2,2">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="rowBd" Property="Background" Value="#28FFFFFF"/>
                                                                <Setter TargetName="rowBd" Property="BorderBrush" Value="#48FFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="rowBd" Property="Background" Value="#38A855F7"/>
                                                                <Setter TargetName="rowBd" Property="BorderBrush" Value="#80C084FC"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46"/>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="220"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="125"/>
                                                    <ColumnDefinition Width="95"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Click="TaskItemCheckBox_Click"/>

                                                <Image Grid.Column="1"
                                                       Source="{Binding Icon}"
                                                       Width="26" Height="26"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"/>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProcessName}" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding LastBlockedText, StringFormat='Último: {0}'}" Foreground="#94A3B8" FontSize="10.5"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Description}"
                                                           Foreground="#CBD5E1"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,10,0"/>

                                                <Border Grid.Column="4"
                                                        Background="#28FFFFFF"
                                                        BorderBrush="#40FFFFFF"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProfileGroup}" Foreground="#E2E8F0" FontSize="11"/>
                                                </Border>

                                                <Border Grid.Column="5"
                                                        Background="#30A855F7"
                                                        BorderBrush="#66C084FC"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="10,3"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BlockedCount}" Foreground="White" FontWeight="Bold" FontSize="12.5"/>
                                                </Border>

                                                <Button Grid.Column="6"
                                                        Content="✕"
                                                        Style="{StaticResource TitleBarButtonStyle}"
                                                        Width="28" Height="28"
                                                        ToolTip="Quitar de la lista"
                                                        Tag="{Binding}"
                                                        Click="DeleteSingleTaskRow_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ==================== VIEW 2: CONDITIONAL BLOCKING & PROFILES (DEDICATED SECTION) ==================== -->
                    <Grid x:Name="ViewConditionalRules" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Bloqueo Condicional y Perfiles de Programas" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Bloquea procesos residuales (ej. Adobe IPC / Crash Processor) cuando su programa principal NO está activo, o agrupa por perfiles."
                                           Foreground="#CBD5E1" FontSize="12.5" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource AccentButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="CreateNewConditionalRule_Click"
                                    Content="＋ Nueva Regla / Perfil"/>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <!-- Rules Cards List -->
                                <ColumnDefinition Width="1.25*"/>
                                <!-- Selected Rule Editor Panel -->
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Conditional Rule Cards -->
                            <Border Grid.Column="0"
                                    Background="#1EFFFFFF"
                                    BorderBrush="#35FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="10"
                                    Margin="0,0,12,0">
                                <ListBox x:Name="ConditionalRulesListBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         SelectionChanged="ConditionalRulesListBox_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,4"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="cardBd"
                                                                Background="#1CFFFFFF"
                                                                BorderBrush="#32FFFFFF"
                                                                BorderThickness="1"
                                                                CornerRadius="12"
                                                                Padding="14,12">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="cardBd" Property="Background" Value="#2CFFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="cardBd" Property="Background" Value="#38A855F7"/>
                                                                <Setter TargetName="cardBd" Property="BorderBrush" Value="#90C084FC"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <DockPanel>
                                                    <CheckBox DockPanel.Dock="Left"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,10,0"
                                                              Click="ConditionalRuleToggle_Click"/>
                                                    <Border DockPanel.Dock="Right"
                                                            Background="#30FFFFFF"
                                                            CornerRadius="8"
                                                            Padding="8,3">
                                                        <TextBlock Text="{Binding CurrentStateText}" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                                </DockPanel>

                                                <TextBlock Text="{Binding Description}" Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" Margin="26,4,0,8"/>

                                                <Border Background="#18000000" CornerRadius="8" Padding="10,7" Margin="26,0,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ModeDisplayName}" Foreground="#C084FC" FontSize="11.5" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding AnchorListSummary, StringFormat='🎯 Si activo(s): {0}'}" Foreground="#E2E8F0" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding TargetListSummary, StringFormat='🚫 Bloquear: {0}'}" Foreground="#FCA5A5" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- Right: Detailed Rule Inspector / Editor -->
                            <Border Grid.Column="1"
                                    Background="#22FFFFFF"
                                    BorderBrush="#38FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="RuleEditorPanel">
                                        <TextBlock Text="Configurar Regla / Perfil" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>

                                        <TextBlock Text="Nombre del Perfil o Regla:" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox x:Name="RuleNameBox" Style="{StaticResource GlassTextBoxStyle}" Margin="0,0,0,10"/>

                                        <TextBlock Text="Modo de Comportamiento:" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="RuleModeCombo" Margin="0,0,0,10" Padding="8,6" SelectedIndex="0">
                                            <ComboBoxItem Content="Bloquear procesos hijos cuando el programa padre NO esté activo"/>
                                            <ComboBoxItem Content="Bloquear procesos objetivo SOLO cuando el programa padre ESTÉ activo"/>
                                            <ComboBoxItem Content="Perfil / Paquete directo (Bloquear todo el grupo siempre)"/>
                                        </ComboBox>

                                        <CheckBox x:Name="RuleKillOnExitCheck"
                                                  Content="Cerrar residuos automáticamente al cerrar el programa principal"
                                                  Foreground="White"
                                                  IsChecked="True"
                                                  Margin="0,0,0,12"/>

                                        <TextBlock Text="Programas Principales (Padres / Ancla, separados por coma):"
                                                   Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBlock Text="Ej: Photoshop.exe, Illustrator.exe, Premiere Pro.exe"
                                                   Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox x:Name="RuleAnchorsBox" Style="{StaticResource GlassTextBoxStyle}" Margin="0,0,0,12"/>

                                        <TextBlock Text="Procesos Dependientes a Bloquear (separados por coma):"
                                                   Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBlock Text="Ej: adobe crash processor.exe, adobeipcbroker.exe, ccxprocess.exe"
                                                   Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox x:Name="RuleTargetsBox"
                                                 Style="{StaticResource GlassTextBoxStyle}"
                                                 Height="72"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 Margin="0,0,0,14"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource GlassButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    Click="DeleteConditionalRule_Click"
                                                    Content="Eliminar Regla"/>
                                            <Button Style="{StaticResource AccentButtonStyle}"
                                                    Click="SaveConditionalRuleChanges_Click"
                                                    Content="Guardar Cambios"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ==================== VIEW 3: WINDOWS STARTUP MANAGER ==================== -->
                    <Grid x:Name="ViewStartupManager" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Gestor de Inicio Automático de Windows" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Habilita, deshabilita o agrega aplicaciones que arrancan junto con Windows (Registro HKCU/HKLM y Carpeta Startup)."
                                           Foreground="#CBD5E1" FontSize="12.5" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GlassButtonStyle}"
                                        Margin="0,0,8,0"
                                        Click="RefreshStartupItems_Click"
                                        Content="🔄 Actualizar"/>
                                <Button Style="{StaticResource AccentButtonStyle}"
                                        Click="AddStartupProgram_Click"
                                        Content="＋ Agregar al Inicio"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1"
                                Background="#1EFFFFFF"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="8">
                            <ListBox x:Name="StartupItemsListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,3"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="#16FFFFFF"
                                                            BorderBrush="#28FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="14,9"
                                                            Margin="2">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Tag="{Binding}"
                                                      Click="StartupItemToggle_Click"/>

                                            <Image Grid.Column="1" Source="{Binding Icon}" Width="26" Height="26" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding StatusText}" Foreground="#A855F7" FontSize="11"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Command}"
                                                       Foreground="#CBD5E1"
                                                       FontSize="11.5"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,12,0"/>

                                            <Border Grid.Column="4"
                                                    Background="#26FFFFFF"
                                                    CornerRadius="6"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SourceLocation}" Foreground="#E2E8F0" FontSize="11"/>
                                            </Border>

                                            <Button Grid.Column="5"
                                                    Content="🗑"
                                                    Style="{StaticResource TitleBarButtonStyle}"
                                                    Tag="{Binding}"
                                                    ToolTip="Eliminar del inicio"
                                                    Click="DeleteStartupItem_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- ==================== VIEW 4: PREFERENCES & GLASS CUSTOMIZATION ==================== -->
                    <Grid x:Name="ViewPreferences" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Classic + Modern Preferences -->
                        <Border Grid.Column="0"
                                Background="#20FFFFFF"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="18"
                                Margin="0,0,12,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Preferencias del Sistema" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <TextBlock Text="OPCIONES GENERALES" Foreground="#C084FC" FontSize="11" FontWeight="Bold" Margin="0,4,0,6"/>
                                    <CheckBox x:Name="PrefLaunchStartup" Content="Iniciar Task Blocker automáticamente con Windows" Foreground="White" Margin="0,4"/>
                                    <CheckBox x:Name="PrefShowForeground" Content="Mostrar ventana en primer plano al iniciar (desmarcar para iniciar en bandeja)" Foreground="White" Margin="0,4"/>
                                    <CheckBox x:Name="PrefMinimizeTray" Content="Minimizar a la bandeja del sistema (System Tray) al cerrar" Foreground="White" Margin="0,4"/>

                                    <Separator Background="#28FFFFFF" Margin="0,12"/>

                                    <TextBlock Text="MOTOR DE TAREAS Y MONITOREO" Foreground="#C084FC" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="PrefStartMonitoring" Content="Iniciar monitoreo automáticamente al abrir la aplicación" Foreground="White" Margin="0,4"/>
                                    <CheckBox x:Name="PrefShowNotification" Content="Mostrar notificación cuando se bloquee un proceso" Foreground="White" Margin="0,4"/>
                                    <CheckBox x:Name="PrefMonitorModeOnly" Content="Modo Monitor (solo contar y registrar sin terminar los procesos)" Foreground="White" Margin="0,4"/>
                                    <CheckBox x:Name="PrefFastRealtime" Content="Intercepción en tiempo real de bajo consumo (Eventos WMI + Snapshot rápido)" Foreground="White" Margin="0,4"/>

                                    <Separator Background="#28FFFFFF" Margin="0,12"/>

                                    <TextBlock Text="REGISTRO EN ARCHIVO (LOG)" Foreground="#C084FC" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="PrefEnableLog" Content="Habilitar guardado de historial en archivo (taskblocker.log)" Foreground="White" Margin="0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6">
                                        <CheckBox x:Name="PrefWarnLogSize" Content="Advertir si el archivo supera (MB):" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="PrefMaxLogMbBox" Style="{StaticResource GlassTextBoxStyle}" Width="70" Text="15.0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6">
                                        <TextBlock Text="Editor de log por defecto:" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="PrefLogEditorBox" Style="{StaticResource GlassTextBoxStyle}" Width="180" Text="notepad.exe"/>
                                        <Button Style="{StaticResource GlassButtonStyle}" Margin="8,0,0,0" Click="OpenLogFile_Click" Content="Abrir Log"/>
                                    </StackPanel>

                                    <Button Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Left"
                                            Margin="0,16,0,0"
                                            Click="SavePreferences_Click"
                                            Content="💾 Aplicar y Guardar Preferencias"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right: Translucent Glass & Live Activity Log -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Glass Customization Card -->
                            <Border Grid.Row="0"
                                    Background="#20FFFFFF"
                                    BorderBrush="#35FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="✨ Apariencia Acrílica (Estilo example.jpg / Wintoys)" Foreground="White" FontSize="14.5" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Ajusta el nivel de transparencia del cristal y el tinte de fondo en tiempo real:" Foreground="#CBD5E1" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="Opacidad del Cristal:" Foreground="White" Width="130"/>
                                        <Slider x:Name="GlassOpacitySlider"
                                                Minimum="0.25" Maximum="0.95" Value="0.72"
                                                VerticalAlignment="Center"
                                                ValueChanged="GlassOpacitySlider_ValueChanged"/>
                                    </DockPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Style="{StaticResource GlassButtonStyle}" Margin="0,0,6,0" Click="ThemeNebula_Click" Content="🔮 Nebulosa (example.jpg)"/>
                                        <Button Style="{StaticResource GlassButtonStyle}" Margin="0,0,6,0" Click="ThemeWintoys_Click" Content="🌑 Cristal Wintoys"/>
                                        <Button Style="{StaticResource GlassButtonStyle}" Click="ThemeCyan_Click" Content="❄️ Cian Ártico"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Live Blocked Event Feed -->
                            <Border Grid.Row="1"
                                    Background="#20FFFFFF"
                                    BorderBrush="#35FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Actividad Reciente en Tiempo Real" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <ListBox x:Name="ActivityFeedListBox"
                                             Grid.Row="1"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#E2E8F0"
                                             FontSize="11.5"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ==================== MODAL OVERLAY: ADD TASK (MANUAL / FILE / ACTIVE PROCESS WITH PREDICTIVE SEARCH) ==================== -->
                    <Border x:Name="AddTaskOverlay"
                            Visibility="Collapsed"
                            Background="#B8090D16"
                            CornerRadius="14"
                            Padding="24">
                        <Border Background="#F01E1638"
                                BorderBrush="#66C084FC"
                                BorderThickness="1.5"
                                CornerRadius="16"
                                MaxWidth="760"
                                MaxHeight="560"
                                Padding="22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Modal Header -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Agregar Proceso a la Lista de Bloqueo" Foreground="White" FontSize="17" FontWeight="Bold"/>
                                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource TitleBarButtonStyle}" HorizontalAlignment="Right" Click="CloseAddTaskDialog_Click"/>
                                </DockPanel>

                                <!-- 3 Classic Modes upgraded with Predictive Search & File Picker -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nombre del ejecutable o filtro predictivo en procesos activos:" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox x:Name="ModalProcessInputBox"
                                                 Style="{StaticResource GlassTextBoxStyle}"
                                                 TextChanged="ModalProcessInputBox_TextChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                                        <Button Style="{StaticResource GlassButtonStyle}"
                                                Margin="0,0,8,0"
                                                Click="BrowseExeFile_Click"
                                                Content="📁 Desde Archivo (.exe)..."/>
                                        <Button Style="{StaticResource GlassButtonStyle}"
                                                Click="RefreshActiveProcessesModal_Click"
                                                Content="🔄 Refrescar Activos"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Active Processes Table with Real Icons & Predictive Filtering -->
                                <Border Grid.Row="2"
                                        Background="#22FFFFFF"
                                        BorderBrush="#38FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="190"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="85"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Icono" Foreground="#94A3B8" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="Nombre" Foreground="#94A3B8" FontSize="11"/>
                                            <TextBlock Grid.Column="2" Text="PID" Foreground="#94A3B8" FontSize="11"/>
                                            <TextBlock Grid.Column="3" Text="Descripción" Foreground="#94A3B8" FontSize="11"/>
                                            <TextBlock Grid.Column="4" Text="Memoria" Foreground="#94A3B8" FontSize="11"/>
                                        </Grid>

                                        <ListBox x:Name="ActiveProcessesModalList"
                                                 Grid.Row="1"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="White"
                                                 HorizontalContentAlignment="Stretch"
                                                 SelectionChanged="ActiveProcessesModalList_SelectionChanged"
                                                 MouseDoubleClick="ActiveProcessesModalList_MouseDoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="38"/>
                                                            <ColumnDefinition Width="190"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="85"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Left"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ProcessName}" Foreground="White" FontWeight="SemiBold" FontSize="12.5"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Id}" Foreground="#CBD5E1" FontSize="12"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Description}" Foreground="#CBD5E1" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding MemoryText}" Foreground="#A855F7" FontSize="11.5"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <!-- Modal Footer -->
                                <DockPanel Grid.Row="3" Margin="0,14,0,0">
                                    <TextBlock x:Name="ActiveProcessCountLabel"
                                               Text="Procesos activos: 0"
                                               Foreground="#CBD5E1"
                                               VerticalAlignment="Center"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource GlassButtonStyle}" Margin="0,0,10,0" Click="CloseAddTaskDialog_Click" Content="Cancelar"/>
                                        <Button Style="{StaticResource AccentButtonStyle}" Click="ConfirmAddTaskFromModal_Click" Content="＋ Agregar a Bloqueados"/>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Border>

                </Grid>
            </Grid>

            <!-- ==================== BOTTOM STATUS BAR ==================== -->
            <Border Grid.Row="2"
                    Background="#22090D16"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FooterStatusText"
                               DockPanel.Dock="Left"
                               Text="Estado: Ejecutando motor de intercepción en tiempo real (Bajo uso de CPU)."
                               Foreground="#CBD5E1"
                               FontSize="11.5"/>
                    <TextBlock x:Name="FooterBlockedSummaryText"
                               DockPanel.Dock="Right"
                               Text="Total Bloqueados: 29"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="11.5"
                               HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
