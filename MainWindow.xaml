<Window x:Class="WinTaskBlocker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:svc="clr-namespace:WinTaskBlocker.Services"
        Title="Win Task Blocker"
        Icon="pack://application:,,,/Assets/logo.png"
        Width="1120" Height="720"
        MinWidth="940" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        DataContext="{x:Static svc:LocalizationService.Instance}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="8"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Single Rounded Glass Border matching Windows 11 native 8px DWM corner radius (No double corner border) -->
    <Border x:Name="RootGlassBorder"
            CornerRadius="8"
            BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Background>
            <!-- Default: 40% Opacity Windows Blue Crystal -->
            <LinearGradientBrush x:Name="RootGlassGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="GradStop1" Color="#66103068" Offset="0.0"/>
                <GradientStop x:Name="GradStop2" Color="#660E2656" Offset="0.48"/>
                <GradientStop x:Name="GradStop3" Color="#660B193A" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Integrated Titlebar -->
                <RowDefinition Height="54"/>
                <!-- Main Body -->
                <RowDefinition Height="*"/>
                <!-- Bottom Status Bar -->
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- ==================== INTEGRATED TITLE BAR ==================== -->
            <Border Grid.Row="0"
                    Background="#18FFFFFF"
                    BorderBrush="#26FFFFFF"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="245"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Brand & Official Win Task Blocker Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               Width="32" Height="32"
                               Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Win Task Blocker" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding AppSubtitle}" Foreground="#CBD5E1" FontSize="10.5"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Global Predictive Search Bar (Works across Blocked Tasks, Conditional Rules & Startup; hidden in Prefs/About) -->
                    <Border x:Name="GlobalSearchBorder"
                            Grid.Column="1"
                            MaxWidth="440"
                            Height="34"
                            CornerRadius="17"
                            Background="#26FFFFFF"
                            BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Margin="12,0">
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="M10,2 A8,8 0 1,0 10,18 A8,8 0 1,0 10,2 M16,16 L21,21"
                                  Stroke="#CBD5E1"
                                  StrokeThickness="1.8"
                                  Stretch="Uniform"
                                  Width="13" Height="13"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"/>
                            <TextBox x:Name="GlobalSearchBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     CaretBrush="{DynamicResource ThemeAccentPrimaryBrush}"
                                     VerticalContentAlignment="Center"
                                     FontSize="12.5"
                                     TextChanged="GlobalSearchBox_TextChanged"/>
                            <TextBlock x:Name="GlobalSearchPlaceholder"
                                       Grid.Column="1"
                                       Text="{Binding SearchPlaceholderBlocked}"
                                       Foreground="#B8CBD5E1"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"/>
                            <Button x:Name="ClearSearchBtn"
                                    Grid.Column="2"
                                    Content="✕"
                                    Visibility="Collapsed"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    Width="22" Height="22"
                                    Click="ClearSearchBtn_Click"/>
                        </Grid>
                    </Border>

                    <!-- Language Flag Switcher, Engine Status Badge & Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Language Switcher Button with Vector Flag (EN / ES) -->
                        <Button x:Name="LanguageFlagBtn"
                                Style="{StaticResource GlassButtonStyle}"
                                Padding="9,4"
                                Margin="0,0,10,0"
                                ToolTip="{Binding FlagTooltip}"
                                Click="LanguageFlagBtn_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Crisp Vector Flag Icon (Updated dynamically for EN / ES) -->
                                <Border Width="20" Height="14" CornerRadius="2" ClipToBounds="True" BorderBrush="#55FFFFFF" BorderThickness="0.8" Margin="0,0,6,0">
                                    <Grid>
                                        <!-- English (US/UK Flag representation) -->
                                        <Grid x:Name="FlagEnglishIcon" Visibility="Visible">
                                            <Rectangle Fill="#B91C1C"/>
                                            <StackPanel>
                                                <Rectangle Height="2" Fill="#B91C1C"/>
                                                <Rectangle Height="2" Fill="White"/>
                                                <Rectangle Height="2" Fill="#B91C1C"/>
                                                <Rectangle Height="2" Fill="White"/>
                                                <Rectangle Height="2" Fill="#B91C1C"/>
                                                <Rectangle Height="2" Fill="White"/>
                                                <Rectangle Height="2" Fill="#B91C1C"/>
                                            </StackPanel>
                                            <Rectangle Width="9" Height="8" Fill="#1E3A8A" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        </Grid>
                                        <!-- Spanish Flag representation -->
                                        <Grid x:Name="FlagSpanishIcon" Visibility="Collapsed">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="3.5*"/>
                                                <RowDefinition Height="7*"/>
                                                <RowDefinition Height="3.5*"/>
                                            </Grid.RowDefinitions>
                                            <Rectangle Grid.Row="0" Fill="#C60B1E"/>
                                            <Rectangle Grid.Row="1" Fill="#FFC400"/>
                                            <Rectangle Grid.Row="2" Fill="#C60B1E"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="LanguageCodeText" Text="EN" Foreground="White" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Protection Status Toggle Button (Block Enabled / Block Disabled) -->
                        <Button x:Name="HeaderEngineBadge"
                                Style="{StaticResource GlassButtonStyle}"
                                Background="#2822C55E"
                                BorderBrush="#6622C55E"
                                BorderThickness="1"
                                Padding="11,4"
                                Margin="0,0,10,0"
                                ToolTip="{Binding HeaderToggleTooltip}"
                                Click="ToggleEngine_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="EngineStatusDot" Width="8" Height="8" Fill="#4ADE80" Margin="0,0,6,0"/>
                                <TextBlock x:Name="EngineStatusHeaderText" Text="{Binding ProtectionActive}" Foreground="White" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource TitleBarButtonStyle}" ToolTip="{Binding MinTooltip}" Click="MinimizeWindow_Click" Content="—"/>
                        <Button Style="{StaticResource TitleBarButtonStyle}" ToolTip="{Binding MaxTooltip}" Click="MaximizeWindow_Click" Content="▢"/>
                        <Button Style="{StaticResource TitleBarButtonStyle}" ToolTip="{Binding CloseTooltip}" Click="CloseWindow_Click" Content="✕"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== MAIN BODY (SIDEBAR + CONTENT) ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR -->
                <Border Grid.Column="0"
                        Background="#1A0F172A"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="0,0,1,0"
                        Padding="12,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Main Navigation Items -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding ControlPanelHeader}" Foreground="#94A3B8" FontSize="10.5" FontWeight="Bold" Margin="10,0,0,6"/>

                            <RadioButton x:Name="NavBlockedBtn"
                                         Style="{StaticResource NavRadioButtonStyle}"
                                         IsChecked="True"
                                         Checked="NavButton_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource ThemeAccentPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding NavBlockedTasks}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavConditionalBtn"
                                         Style="{StaticResource NavRadioButtonStyle}"
                                         Checked="NavButton_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#38BDF8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding NavConditional}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavStartupBtn"
                                         Style="{StaticResource NavRadioButtonStyle}"
                                         Checked="NavButton_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#4ADE80" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding NavStartup}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavHostsBtn"
                                         Style="{StaticResource NavRadioButtonStyle}"
                                         Checked="NavButton_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#FB7185" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding NavHosts}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavPrefsBtn"
                                         Style="{StaticResource NavRadioButtonStyle}"
                                         Checked="NavButton_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#FBBF24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding NavPreferences}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavAboutBtn"
                                         Style="{StaticResource NavRadioButtonStyle}"
                                         Checked="NavButton_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#F472B6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding NavAbout}"/>
                                </StackPanel>
                            </RadioButton>

                            <Separator Background="#28FFFFFF" Margin="6,10"/>

                            <TextBlock Text="{Binding QuickProfilesHeader}" Foreground="#94A3B8" FontSize="10.5" FontWeight="Bold" Margin="10,0,0,6"/>
                        </StackPanel>

                        <!-- Dynamic Quick Profiles List (Automatically updates when profiles/rules are added, edited, or deleted) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <StackPanel>
                                <Button Style="{StaticResource GlassButtonStyle}"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,2.5"
                                        Click="QuickFilterAll_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#E2E8F0" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding AllProcessesLabel}" FontSize="12"/>
                                    </StackPanel>
                                </Button>

                                <ItemsControl x:Name="QuickProfilesItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GlassButtonStyle}"
                                                    HorizontalContentAlignment="Left"
                                                    Margin="0,2.5"
                                                    Tag="{Binding FilterKey}"
                                                    Click="DynamicQuickProfileBtn_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding DotColor}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="165"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Session Summary Card at Bottom of Sidebar -->
                        <Border Grid.Row="2"
                                Background="#24FFFFFF"
                                BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="{Binding SessionSummaryHeader}" Foreground="#CBD5E1" FontSize="10" FontWeight="Bold"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="SidebarActiveRulesCount" Text="16" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ActiveRulesLabel}" Foreground="#CBD5E1" FontSize="10.5"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="SidebarTotalBlockedCount" Text="29" Foreground="{DynamicResource ThemeAccentPrimaryBrush}" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding BlockedCountLabel}" Foreground="#CBD5E1" FontSize="10.5"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================== RIGHT CONTENT PANELS ==================== -->
                <Grid Grid.Column="1" Margin="18,14,18,14">

                    <!-- ==================== VIEW 1: BLOCKED TASKS LIST ==================== -->
                    <Grid x:Name="ViewBlockedTasks" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Toolbar (Uses Grid with * and Auto so buttons are NEVER clipped) -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BlockedViewTitle}" Foreground="White" FontSize="19" FontWeight="Bold"/>
                                <TextBlock Text="{Binding BlockedViewSubtitle}"
                                           Foreground="#CBD5E1"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="StartStopEngineBtn"
                                        Style="{StaticResource GlassButtonStyle}"
                                        Margin="0,0,7,0"
                                        Click="ToggleEngine_Click"
                                        Content="{Binding PauseEngineBtn}"/>
                                <Button Style="{StaticResource GlassButtonStyle}"
                                        Margin="0,0,7,0"
                                        Click="ImportExportIni_Click"
                                        Content="📂 config.ini"/>
                                <Button Style="{StaticResource AccentButtonStyle}"
                                        Click="OpenAddTaskDialog_Click"
                                        Content="{Binding AddTaskBtn}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Quick Predictive Add Bar + Action Buttons -->
                        <Border Grid.Row="1"
                                Background="#22FFFFFF"
                                BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="11,9"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,10,0">
                                    <TextBox x:Name="QuickAddProcessBox"
                                             Style="{StaticResource GlassTextBoxStyle}"
                                             TextChanged="QuickAddProcessBox_TextChanged"
                                             KeyDown="QuickAddProcessBox_KeyDown"/>
                                    <TextBlock x:Name="QuickAddPlaceholder"
                                               Text="{Binding QuickAddPlaceholder}"
                                               Foreground="#94A3B8"
                                               FontSize="11.5"
                                               Margin="12,0,8,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False"/>
                                    <Popup x:Name="PredictivePopup"
                                           PlacementTarget="{Binding ElementName=QuickAddProcessBox}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True">
                                        <Border Background="{DynamicResource ThemeModalBgBrush}"
                                                BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="4"
                                                Width="440"
                                                MaxHeight="210">
                                            <ListBox x:Name="PredictiveSuggestionsList"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="White"
                                                     SelectionChanged="PredictiveSuggestionsList_SelectionChanged">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="4,3">
                                                            <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" Foreground="White" Width="170"/>
                                                            <TextBlock Text="{Binding Description}" Foreground="#CBD5E1" FontSize="11.5"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <Button Grid.Column="1"
                                        Style="{StaticResource GlassButtonStyle}"
                                        Margin="0,0,7,0"
                                        Click="QuickAddConfirm_Click"
                                        Content="{Binding BlockNowBtn}"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource GlassButtonStyle}"
                                        Margin="0,0,7,0"
                                        Click="ResetCounters_Click"
                                        Content="{Binding ResetCountersBtn}"/>
                                <Button Grid.Column="3"
                                        Style="{StaticResource GlassButtonStyle}"
                                        Click="RemoveSelectedTask_Click"
                                        Content="{Binding DeleteSelectedBtn}"/>
                            </Grid>
                        </Border>

                        <!-- Blocked Tasks Glass Table -->
                        <Border Grid.Row="2"
                                Background="#1EFFFFFF"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Table Column Headers -->
                                <Border Grid.Row="0" BorderBrush="#28FFFFFF" BorderThickness="0,0,0,1" Padding="12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="215"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="SelectAllCheckBox" Grid.Column="0" VerticalAlignment="Center" IsChecked="True" Click="SelectAllCheckBox_Click"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ColIcon}" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ColProcess}" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding ColDescription}" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding ColProfile}" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding ColBlocked}" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- ListBox of Blocked Task Rows -->
                                <ListBox x:Name="BlockedTasksListBox"
                                         Grid.Row="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,2"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="rowBd"
                                                                Background="#12FFFFFF"
                                                                BorderBrush="#1EFFFFFF"
                                                                BorderThickness="1"
                                                                CornerRadius="9"
                                                                Padding="12,7"
                                                                Margin="2,2,4,2">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="rowBd" Property="Background" Value="#28FFFFFF"/>
                                                                <Setter TargetName="rowBd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBorderBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="rowBd" Property="Background" Value="{DynamicResource ThemeAccentRowSelectBgBrush}"/>
                                                                <Setter TargetName="rowBd" Property="BorderBrush" Value="{DynamicResource ThemeAccentHoverBorderBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="215"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="44"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          VerticalAlignment="Center"
                                                          Click="TaskItemCheckBox_Click"/>

                                                <Image Grid.Column="1"
                                                       Source="{Binding Icon}"
                                                       Width="26" Height="26"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"/>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding ProcessName}" Foreground="White" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding LastBlockedText}" Foreground="#94A3B8" FontSize="10.5"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Description}"
                                                           Foreground="#CBD5E1"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,10,0"/>

                                                <Border Grid.Column="4"
                                                        Background="#28FFFFFF"
                                                        BorderBrush="#40FFFFFF"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProfileGroup}" Foreground="#E2E8F0" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="112"/>
                                                </Border>

                                                <Border Grid.Column="5"
                                                        Background="{DynamicResource ThemeAccentSoftBgBrush}"
                                                        BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="10,2.5"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BlockedCount}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                                </Border>

                                                <Button Grid.Column="6"
                                                        Content="✕"
                                                        Style="{StaticResource TitleBarButtonStyle}"
                                                        Width="28" Height="28"
                                                        Tag="{Binding}"
                                                        Click="DeleteSingleTaskRow_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ==================== VIEW 2: CONDITIONAL BLOCKING & PROFILES ==================== -->
                    <Grid x:Name="ViewConditionalRules" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="{Binding CondViewTitle}" Foreground="White" FontSize="19" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CondViewSubtitle}"
                                           Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource AccentButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="CreateNewConditionalRule_Click"
                                    Content="{Binding NewRuleBtn}"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Conditional Rule Cards -->
                            <Border Grid.Column="0"
                                    Background="#1EFFFFFF"
                                    BorderBrush="#35FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8"
                                    Margin="0,0,12,0">
                                <ListBox x:Name="ConditionalRulesListBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         SelectionChanged="ConditionalRulesListBox_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,4"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="cardBd"
                                                                Background="#1CFFFFFF"
                                                                BorderBrush="#32FFFFFF"
                                                                BorderThickness="1"
                                                                CornerRadius="11"
                                                                Padding="13,11"
                                                                Margin="2,1,4,1">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="cardBd" Property="Background" Value="#2CFFFFFF"/>
                                                                <Setter TargetName="cardBd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBorderBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="cardBd" Property="Background" Value="{DynamicResource ThemeAccentRowSelectBgBrush}"/>
                                                                <Setter TargetName="cardBd" Property="BorderBrush" Value="{DynamicResource ThemeAccentHoverBorderBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,10,0"
                                                              Click="ConditionalRuleToggle_Click"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="9" Height="9" Fill="{Binding BadgeColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2"
                                                            Background="#30FFFFFF"
                                                            CornerRadius="8"
                                                            Padding="8,3"
                                                            Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding CurrentStateText}" Foreground="#E2E8F0" FontSize="10.5" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{Binding Description}" Foreground="#CBD5E1" FontSize="11.5" TextWrapping="Wrap" Margin="26,4,0,7"/>

                                                <Border Background="#1A000000" CornerRadius="8" Padding="10,6" Margin="26,0,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ModeDisplayName}" Foreground="{DynamicResource ThemeAccentPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding AnchorListSummary}" Foreground="#E2E8F0" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding TargetListSummary}" Foreground="#FCA5A5" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- Right: Detailed Rule Inspector / Editor -->
                            <Border Grid.Column="1"
                                    Background="#22FFFFFF"
                                    BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="15">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="RuleEditorPanel" Margin="0,0,4,0">
                                        <TextBlock Text="{Binding EditorHeader}" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>

                                        <TextBlock Text="{Binding RuleNameLabel}" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox x:Name="RuleNameBox" Style="{StaticResource GlassTextBoxStyle}" Margin="0,0,0,8"/>

                                        <TextBlock Text="{Binding RuleDescLabel}" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                                        <TextBox x:Name="RuleDescBox" Style="{StaticResource GlassTextBoxStyle}" Margin="0,0,0,8"/>

                                        <TextBlock Text="{Binding RuleModeLabel}" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="RuleModeCombo" Margin="0,0,0,8" Padding="8,5" SelectedIndex="0">
                                            <ComboBoxItem Content="{Binding ModeOptionInactive}"/>
                                            <ComboBoxItem Content="{Binding ModeOptionActive}"/>
                                            <ComboBoxItem Content="{Binding ModeOptionAlways}"/>
                                        </ComboBox>

                                        <CheckBox x:Name="RuleKillOnExitCheck"
                                                  Content="{Binding KillOnExitLabel}"
                                                  Foreground="White"
                                                  IsChecked="True"
                                                  Margin="0,0,0,10"/>

                                        <TextBlock Text="{Binding AnchorsLabel}" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding AnchorsHint}" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox x:Name="RuleAnchorsBox" Style="{StaticResource GlassTextBoxStyle}" Margin="0,0,0,10"/>

                                        <TextBlock Text="{Binding TargetsLabel}" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding TargetsHint}" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBox x:Name="RuleTargetsBox"
                                                 Style="{StaticResource GlassTextBoxStyle}"
                                                 Height="68"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 Margin="0,0,0,12"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource GlassButtonStyle}"
                                                    Margin="0,0,8,0"
                                                    Click="DeleteConditionalRule_Click"
                                                    Content="{Binding DeleteRuleBtn}"/>
                                            <Button Style="{StaticResource AccentButtonStyle}"
                                                    Click="SaveConditionalRuleChanges_Click"
                                                    Content="{Binding SaveRuleBtn}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ==================== VIEW 3: WINDOWS STARTUP MANAGER ==================== -->
                    <Grid x:Name="ViewStartupManager" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="{Binding StartupViewTitle}" Foreground="White" FontSize="19" FontWeight="Bold"/>
                                <TextBlock Text="{Binding StartupViewSubtitle}"
                                           Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GlassButtonStyle}"
                                        Margin="0,0,8,0"
                                        Click="RefreshStartupItems_Click"
                                        Content="{Binding RefreshBtn}"/>
                                <Button Style="{StaticResource AccentButtonStyle}"
                                        Click="AddStartupProgram_Click"
                                        Content="{Binding AddStartupBtn}"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="#1EFFFFFF"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8">
                            <ListBox x:Name="StartupItemsListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,3"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="#16FFFFFF"
                                                            BorderBrush="#28FFFFFF"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="14,9"
                                                            Margin="2,1,4,1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="44"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Tag="{Binding}"
                                                      Click="StartupItemToggle_Click"/>

                                            <Image Grid.Column="1" Source="{Binding Icon}" Width="26" Height="26" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource ThemeAccentPrimaryBrush}" FontSize="11"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Command}"
                                                       ToolTip="{Binding Command}"
                                                       Foreground="#CBD5E1"
                                                       FontSize="11.5"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,12,0"/>

                                            <Border Grid.Column="4"
                                                    Background="#26FFFFFF"
                                                    CornerRadius="6"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    MaxWidth="194"
                                                    ToolTip="{Binding SourceLocation}">
                                                <TextBlock Text="{Binding SourceLocation}" Foreground="#E2E8F0" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </Border>

                                            <Button Grid.Column="5"
                                                    Content="🗑"
                                                    Style="{StaticResource TitleBarButtonStyle}"
                                                    Visibility="{Binding DeleteButtonVisibility}"
                                                    Tag="{Binding}"
                                                    Click="DeleteStartupItem_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- ==================== VIEW 3B: HOSTS FILE MANAGER (ADMIN) ==================== -->
                    <Grid x:Name="ViewHostsManager" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Backup / Revert / Save Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{Binding HostsViewTitle}" Foreground="White" FontSize="19" FontWeight="Bold"/>
                                <TextBlock Text="{Binding HostsViewSubtitle}" Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GlassButtonStyle}" Margin="0,0,7,0" Click="HostsBackup_Click" Content="{Binding HostsBackupBtn}"/>
                                <Button x:Name="HostsRevertBtn" Style="{StaticResource GlassButtonStyle}" Margin="0,0,7,0" Click="HostsRevert_Click" Content="{Binding HostsRevertBtn}"/>
                                <Button Style="{StaticResource AccentButtonStyle}" Click="HostsSave_Click" Content="{Binding HostsSaveBtn}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Brief Explanation & Effects Banner -->
                        <Border Grid.Row="1"
                                Background="#1E0F172A"
                                BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,9"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding HostsInfoTitle}" Foreground="{DynamicResource ThemeAccentPrimaryBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding HostsInfoBody}" Foreground="#CBD5E1" FontSize="11.2" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Border>

                        <!-- Add New Host Entry Bar with Safe Suggested Blocking IPs -->
                        <Border Grid.Row="2"
                                Background="#22FFFFFF"
                                BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="11,9"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding HostsIpLabel}" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="HostIpComboBox" IsEditable="True" Padding="6,4" SelectedIndex="0" FontSize="12">
                                        <ComboBoxItem Content="0.0.0.0" Tag="Safe Null Route"/>
                                        <ComboBoxItem Content="127.0.0.1" Tag="Localhost Loopback"/>
                                        <ComboBoxItem Content="::1" Tag="IPv6 Localhost"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding HostsDomainLabel}" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox x:Name="HostDomainInputBox" Style="{StaticResource GlassTextBoxStyle}" Padding="8,5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding HostsCommentLabel}" Foreground="#CBD5E1" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox x:Name="HostCommentInputBox" Style="{StaticResource GlassTextBoxStyle}" Padding="8,5"/>
                                </StackPanel>

                                <Button Grid.Column="3"
                                        Style="{StaticResource AccentButtonStyle}"
                                        VerticalAlignment="Bottom"
                                        Click="HostsAddEntry_Click"
                                        Content="{Binding HostsAddBtn}"/>
                            </Grid>
                        </Border>

                        <!-- Hosts Entries Table -->
                        <Border Grid.Row="3"
                                Background="#1EFFFFFF"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" BorderBrush="#28FFFFFF" BorderThickness="0,0,0,1" Padding="12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="135"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="42"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="HostsSelectAllCheckBox" Grid.Column="0" VerticalAlignment="Center" IsChecked="True" Click="HostsSelectAllCheckBox_Click"/>
                                        <TextBlock Grid.Column="1" Text="{Binding HostsColIp}" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding HostsColDomain}" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding HostsColComment}" Foreground="#CBD5E1" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <ListBox x:Name="HostsEntriesListBox"
                                         Grid.Row="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,2"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border Background="#14FFFFFF"
                                                                BorderBrush="#26FFFFFF"
                                                                BorderThickness="1"
                                                                CornerRadius="9"
                                                                Padding="12,7"
                                                                Margin="2,1,4,1">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="135"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="42"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>

                                                <Border Grid.Column="1"
                                                        Background="{DynamicResource ThemeAccentSoftBgBrush}"
                                                        BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="8,2.5"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding IpAddress}" Foreground="White" FontWeight="SemiBold" FontSize="11.5"/>
                                                </Border>

                                                <TextBlock Grid.Column="2" Text="{Binding Domain}" Foreground="White" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Comment}" Foreground="#CBD5E1" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>

                                                <Button Grid.Column="4"
                                                        Content="✕"
                                                        Style="{StaticResource TitleBarButtonStyle}"
                                                        Width="28" Height="28"
                                                        Tag="{Binding}"
                                                        Click="DeleteHostEntryRow_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ==================== VIEW 4: PREFERENCES & GLASS CUSTOMIZATION ==================== -->
                    <Grid x:Name="ViewPreferences" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.12*"/>
                            <ColumnDefinition Width="0.88*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: System Preferences -->
                        <Border Grid.Column="0"
                                Background="#20FFFFFF"
                                BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,12,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="{Binding PrefsTitle}" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <TextBlock Text="{Binding GeneralSection}" Foreground="{DynamicResource ThemeAccentPrimaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,2,0,6"/>
                                    <CheckBox x:Name="PrefLaunchStartup" Content="{Binding PrefLaunchStartup}" Foreground="White" Margin="0,4"/>
                                    <CheckBox x:Name="PrefStartMinimized" Content="{Binding PrefStartMinimized}" Foreground="White" Margin="0,4"/>
                                    <CheckBox x:Name="PrefShowForeground" Content="{Binding PrefShowForeground}" Foreground="White" Margin="0,4"/>
                                    <CheckBox x:Name="PrefMinimizeTray" Content="{Binding PrefMinimizeTray}" Foreground="White" Margin="0,4"/>

                                    <Separator Background="#28FFFFFF" Margin="0,10"/>

                                    <TextBlock Text="{Binding EngineSection}" Foreground="{DynamicResource ThemeAccentPrimaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="PrefStartMonitoring" Content="{Binding PrefStartMonitoring}" Foreground="White" Margin="0,4"/>
                                    <CheckBox x:Name="PrefShowNotification" Content="{Binding PrefShowNotification}" Foreground="White" Margin="0,4"/>
                                    <CheckBox x:Name="PrefMonitorModeOnly" Content="{Binding PrefMonitorMode}" Foreground="White" Margin="0,4"/>
                                    <CheckBox x:Name="PrefFastRealtime" Content="{Binding PrefRealtime}" Foreground="White" Margin="0,4"/>

                                    <Separator Background="#28FFFFFF" Margin="0,10"/>

                                    <TextBlock Text="{Binding LogSection}" Foreground="{DynamicResource ThemeAccentPrimaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="PrefEnableLog" Content="{Binding PrefEnableLog}" Foreground="White" Margin="0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6">
                                        <CheckBox x:Name="PrefWarnLogSize" Content="{Binding PrefWarnLogSize}" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="PrefMaxLogMbBox" Style="{StaticResource GlassTextBoxStyle}" Width="70" Text="15.0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6">
                                        <TextBlock Text="{Binding DefaultLogEditorLabel}" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="PrefLogEditorBox" Style="{StaticResource GlassTextBoxStyle}" Width="155" Text="notepad.exe"/>
                                        <Button Style="{StaticResource GlassButtonStyle}" Margin="8,0,0,0" Click="OpenLogFile_Click" Content="{Binding OpenLogBtn}"/>
                                    </StackPanel>

                                    <Button Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Left"
                                            Margin="0,14,0,0"
                                            Click="SavePreferences_Click"
                                            Content="{Binding SavePrefsBtn}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right: Crystal Customization (4 Finishes + Opacity Slider) & Live Activity Log -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Crystal Appearance Card -->
                            <Border Grid.Row="0"
                                    Background="#20FFFFFF"
                                    BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="15"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding CrystalTitle}" Foreground="White" FontSize="14.5" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding CrystalSubtitle}" Foreground="#CBD5E1" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <Grid Margin="0,2,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="42"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding CrystalOpacityLabel}" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider x:Name="GlassOpacitySlider"
                                                Grid.Column="1"
                                                Minimum="0.15" Maximum="0.95" Value="0.40"
                                                VerticalAlignment="Center"
                                                ValueChanged="GlassOpacitySlider_ValueChanged"/>
                                        <TextBlock x:Name="GlassOpacityPercentText"
                                                   Grid.Column="2"
                                                   Text="40%"
                                                   Foreground="{DynamicResource ThemeAccentPrimaryBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <UniformGrid Columns="2" Rows="2">
                                        <Button x:Name="BtnThemeWindowsBlue" Style="{StaticResource GlassButtonStyle}" Margin="0,0,5,6" Click="ThemeWindowsBlue_Click" Content="{Binding ThemeWindowsBlue}"/>
                                        <Button x:Name="BtnThemeNebula" Style="{StaticResource GlassButtonStyle}" Margin="5,0,0,6" Click="ThemeNebula_Click" Content="{Binding ThemePurpleNebula}"/>
                                        <Button x:Name="BtnThemeDark" Style="{StaticResource GlassButtonStyle}" Margin="0,0,5,0" Click="ThemeMidnightDark_Click" Content="{Binding ThemeMidnightDark}"/>
                                        <Button x:Name="BtnThemeCyan" Style="{StaticResource GlassButtonStyle}" Margin="5,0,0,0" Click="ThemeCyan_Click" Content="{Binding ThemeArcticCyan}"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Live Blocked Event Feed -->
                            <Border Grid.Row="1"
                                    Background="#20FFFFFF"
                                    BorderBrush="#35FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding ActivityFeedTitle}" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <ListBox x:Name="ActivityFeedListBox"
                                             Grid.Row="1"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#E2E8F0"
                                             FontSize="11.5"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ==================== VIEW 5: ABOUT & CREDITS (INSPIRED BY USER'S SHOWCASE CARD) ==================== -->
                    <Grid x:Name="ViewAboutCredits" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Main Showcase Credits Card (Matches image_2.png layout & aesthetic) -->
                                <Border Background="#D80B111E"
                                        BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
                                        BorderThickness="1.2"
                                        CornerRadius="14"
                                        Padding="26,24"
                                        Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Glowing App Emblem -->
                                        <Border Grid.Column="0"
                                                Width="76" Height="76"
                                                CornerRadius="16"
                                                Background="{DynamicResource ThemeAccentSoftBgBrush}"
                                                BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left">
                                            <Image Source="pack://application:,,,/Assets/logo.png"
                                                   Width="56" Height="56"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <!-- Center Content & Credits -->
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <!-- Title + Pill Badge Row -->
                                            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="{Binding AboutHeaderTitle}"
                                                           Foreground="{DynamicResource ThemeAccentPrimaryBrush}"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,4"/>
                                                <Border Background="{DynamicResource ThemeAccentSoftBgBrush}"
                                                        BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="11"
                                                        Padding="11,3"
                                                        Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding AboutBadgeText}"
                                                               Foreground="{DynamicResource ThemeAccentPrimaryBrush}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                            </WrapPanel>

                                            <!-- Main Description -->
                                            <TextBlock Text="{Binding AboutDescription}"
                                                       Foreground="#F1F5F9"
                                                       FontSize="13.5"
                                                       LineHeight="20"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,10"/>

                                            <!-- Disclaimer -->
                                            <TextBlock Text="{Binding AboutDisclaimer}"
                                                       Foreground="#94A3B8"
                                                       FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,14"/>

                                            <!-- Crafted by Irving Ngr Pill Badge with Crisp Vector Venezuelan Flag -->
                                            <Border Background="#181E293B"
                                                    BorderBrush="#38475569"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Padding="13,7"
                                                    HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CraftedByPrefix}" Foreground="#E2E8F0" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Irving Ngr" Foreground="White" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                    <!-- Crisp Vector Venezuelan Flag (Yellow / Blue with white stars arc / Red) -->
                                                    <Border Width="22" Height="15" CornerRadius="2" ClipToBounds="True" BorderBrush="#50FFFFFF" BorderThickness="0.8" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <Rectangle Grid.Row="0" Fill="#FACC15"/>
                                                            <Grid Grid.Row="1" Background="#1D4ED8">
                                                                <Path Data="M5,4 A6,4 0 0,1 17,4"
                                                                      Stroke="White"
                                                                      StrokeThickness="1.1"
                                                                      StrokeDashArray="1,1.2"/>
                                                            </Grid>
                                                            <Rectangle Grid.Row="2" Fill="#DC2626"/>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Text="{Binding PoweredBySuffix}"
                                                               Foreground="#94A3B8"
                                                               FontSize="11.5"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Version Control & Architecture Details Grid -->
                                <UniformGrid Columns="3">
                                    <Border Background="#1EFFFFFF" BorderBrush="{DynamicResource ThemeAccentBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="15" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CardVersionHeader}" Foreground="{DynamicResource ThemeAccentPrimaryBrush}" FontSize="10.5" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding CardVersionTitle}" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,4,0,4"/>
                                            <TextBlock Text="{Binding CardVersionDesc}" Foreground="#CBD5E1" FontSize="11.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#1EFFFFFF" BorderBrush="{DynamicResource ThemeAccentBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="15" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CardAuthorHeader}" Foreground="{DynamicResource ThemeAccentPrimaryBrush}" FontSize="10.5" FontWeight="Bold"/>
                                            <TextBlock Text="Irving Ngr" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,4,0,4"/>
                                            <TextBlock Text="GitHub: github.com/irvingngr/win-task-blocker" Foreground="#CBD5E1" FontSize="11.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#1EFFFFFF" BorderBrush="{DynamicResource ThemeAccentBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="15" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding CardBilingualHeader}" Foreground="#4ADE80" FontSize="10.5" FontWeight="Bold"/>
                                            <TextBlock Text="English &amp; Español" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,4,0,4"/>
                                            <TextBlock Text="{Binding CardBilingualDesc}" Foreground="#CBD5E1" FontSize="11.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================== MODAL OVERLAY: ADD TASK ==================== -->
                    <Border x:Name="AddTaskOverlay"
                            Visibility="Collapsed"
                            Background="#B8090D16"
                            CornerRadius="12"
                            Padding="20">
                        <Border Background="{DynamicResource ThemeModalBgBrush}"
                                BorderBrush="{DynamicResource ThemeAccentBorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="14"
                                MaxWidth="760"
                                MaxHeight="560"
                                Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Modal Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ModalTitle}" Foreground="White" FontSize="16.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="✕" Style="{StaticResource TitleBarButtonStyle}" Click="CloseAddTaskDialog_Click"/>
                                </Grid>

                                <!-- Predictive Search & File Picker -->
                                <Grid Grid.Row="1" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ModalSearchLabel}" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                                        <Grid>
                                            <TextBox x:Name="ModalProcessInputBox"
                                                     Style="{StaticResource GlassTextBoxStyle}"
                                                     Padding="10,6.5,32,6.5"
                                                     TextChanged="ModalProcessInputBox_TextChanged"/>
                                            <Button x:Name="ClearModalSearchBtn"
                                                    Content="✕"
                                                    Visibility="Collapsed"
                                                    Style="{StaticResource TitleBarButtonStyle}"
                                                    Width="24" Height="24"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,5,0"
                                                    Click="ClearModalSearchBtn_Click"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                                        <Button Style="{StaticResource GlassButtonStyle}"
                                                Margin="0,0,8,0"
                                                Click="BrowseExeFile_Click"
                                                Content="{Binding BrowseFileBtn}"/>
                                        <Button Style="{StaticResource GlassButtonStyle}"
                                                Click="RefreshActiveProcessesModal_Click"
                                                Content="{Binding RefreshActiveBtn}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Active Processes Table -->
                                <Border Grid.Row="2"
                                        Background="#22FFFFFF"
                                        BorderBrush="#38FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Margin="8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38"/>
                                                <ColumnDefinition Width="190"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="85"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ColIcon}" Foreground="#94A3B8" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ColProcess}" Foreground="#94A3B8" FontSize="11"/>
                                            <TextBlock Grid.Column="2" Text="PID" Foreground="#94A3B8" FontSize="11"/>
                                            <TextBlock Grid.Column="3" Text="{Binding ColDescription}" Foreground="#94A3B8" FontSize="11"/>
                                            <TextBlock Grid.Column="4" Text="{Binding ColMemory}" Foreground="#94A3B8" FontSize="11"/>
                                        </Grid>

                                        <ListBox x:Name="ActiveProcessesModalList"
                                                 Grid.Row="1"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="White"
                                                 HorizontalContentAlignment="Stretch"
                                                 SelectionChanged="ActiveProcessesModalList_SelectionChanged"
                                                 MouseDoubleClick="ActiveProcessesModalList_MouseDoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="38"/>
                                                            <ColumnDefinition Width="190"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="85"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Left"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ProcessName}" Foreground="White" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Id}" Foreground="#CBD5E1" FontSize="12"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Description}" Foreground="#CBD5E1" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding MemoryText}" Foreground="{DynamicResource ThemeAccentPrimaryBrush}" FontSize="11.5"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <!-- Modal Footer -->
                                <Grid Grid.Row="3" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ActiveProcessCountLabel"
                                               Grid.Column="0"
                                               Text="Active processes: 0"
                                               Foreground="#CBD5E1"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource GlassButtonStyle}" Margin="0,0,10,0" Click="CloseAddTaskDialog_Click" Content="{Binding CancelBtn}"/>
                                        <Button Style="{StaticResource AccentButtonStyle}" Click="ConfirmAddTaskFromModal_Click" Content="{Binding ConfirmAddBtn}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>

                </Grid>
            </Grid>

            <!-- ==================== BOTTOM STATUS BAR ==================== -->
            <Border Grid.Row="2"
                    Background="#22090D16"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="0,1,0,0"
                    Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterStatusText"
                               Grid.Column="0"
                               Text="{Binding FooterStatusRunning}"
                               Foreground="#CBD5E1"
                               FontSize="11.5"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="FooterBlockedSummaryText"
                               Grid.Column="1"
                               Text="Blocked Tasks: 29"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="11.5"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
